{
  "name": "@boat/prisma",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && rm -rf dist && tsc -p tsconfig.build.json",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:indexes": "prisma db execute --file extra-indexes.sql"
  },
  "dependencies": {
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv": "^18.0.10",
    "prisma": "7.10.1",
    "typescript": "^6.0.2"
  }
}
