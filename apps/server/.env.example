DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# 可选。仅嵌入 Harness 子应用时需要；独立运行可不填
# HARNESS_ORIGIN=https://harness.example.com
# 嵌入时必填：本组件在 Harness Admin 中的组件标识，用于校验 SSO 票据归属
# HARNESS_COMPONENT_ID=your-component-id
# 独立运行时由本服务提供 MCP（POST /api/mcp）。默认关闭
# MCP_ENABLED=true
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_REGION=
