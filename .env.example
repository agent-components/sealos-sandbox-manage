# MongoDB（平台数据库）
MONGODB_URI=mongodb://root:密码@boat-mongodb.ns-428hqav4.svc:27017/boat?authSource=admin

# 登录会话加密密钥（建议不少于 32 字符）
BOAT_SESSION_SECRET=请改成足够长的随机字符串

# Sealos App Launchpad 根地址（不要末尾斜杠）
SEALOS_LAUNCHPAD_BASE=https://applaunchpad.gzg.sealos.run

# Sealos kubeconfig 文件路径（仅服务端，与平台用户无关）
SEALOS_KUBECONFIG_PATH=

# MCP 调用结果对象存储。日志在 MongoDB 的 mcp_logs，这里只存放结果 JSON
MINIO_ENDPOINT=https://objectstorageapi.example.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
