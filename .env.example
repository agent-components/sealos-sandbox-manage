# PostgreSQL。库名写在路径里。登录复用 public.users，其余表在 schema sandbox
DATABASE_URL=postgresql://postgres:密码@harness-postgresql.ns-428hqav4.svc:5432/bl_harness

# Sealos App Launchpad 根地址（不要末尾斜杠）
SEALOS_LAUNCHPAD_BASE=https://applaunchpad.gzg.sealos.run

# Sealos kubeconfig 文件路径（仅服务端，与平台用户无关）
SEALOS_KUBECONFIG_PATH=

# MCP 调用结果对象存储。日志在 PostgreSQL 的 sandbox.mcp_logs，这里只存放结果 JSON
MINIO_ENDPOINT=https://objectstorageapi.example.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
