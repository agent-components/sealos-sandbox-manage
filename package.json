{
  "name": "sealos-sandbox-manage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "node --env-file=.env.local node_modules/prisma/build/index.js generate",
    "db:push": "node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "db:indexes": "node --env-file=.env.local node_modules/prisma/build/index.js db execute --schema prisma/schema.prisma --file prisma/extra-indexes.sql",
    "db:init": "npm run db:generate && npm run db:push -- --skip-generate && npm run db:indexes"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@prisma/client": "^6.19.3",
    "antd": "^6.6.6",
    "dayjs": "^1.11.23",
    "geist": "^1.7.2",
    "js-yaml": "^5.4.3",
    "listpage-components": "^1.0.45",
    "minio": "^8.0.7",
    "next": "16.4.1",
    "node-cron": "^4.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}